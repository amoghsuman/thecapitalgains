              "_key": "c2l1-062",
              "_type": "flashcardSet",
              "title": "Futures Contract Basics",
              "cards": [
                {
                  "_key": "c2l1-062f1",
                  "term": "Lot size",
                  "definition": "The quantity of the commodity covered by one futures contract."
                },
                {
                  "_key": "c2l1-062f2",
                  "term": "Quotation unit",
                  "definition": "The quantity the displayed price refers to, such as ₹ per 10 grams for gold."
                },
                {
                  "_key": "c2l1-062f3",
                  "term": "Tick size",
                  "definition": "The smallest allowed price movement."
                },
                {
                  "_key": "c2l1-062f4",
                  "term": "Tick value",
                  "definition": "The rupee value of a one-tick move on one lot: tick size × lot size ÷ quotation unit."
                },
                {
                  "_key": "c2l1-062f5",
                  "term": "Contract value",
                  "definition": "Price × lot size ÷ quotation unit; the full notional value of one lot."
                },
                {
                  "_key": "c2l1-062f6",
                  "term": "Initial margin",
                  "definition": "The deposit required before trading, based mainly on SPAN margin plus extreme loss margin."
                },
                {
                  "_key": "c2l1-062f7",
                  "term": "Leverage",
                  "definition": "Contract value divided by margin; equal to 1 ÷ margin percentage."
                },
                {
                  "_key": "c2l1-062f8",
                  "term": "Expiry date",
                  "definition": "The last trading day of a futures contract, after which it settles."
                }
              ]
            },
