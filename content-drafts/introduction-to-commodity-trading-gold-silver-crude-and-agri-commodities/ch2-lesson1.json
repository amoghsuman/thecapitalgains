                },
                {
                  "_key": "c2l1-034d2",
                  "label": "8%",
                  "value": 25
                },
                {
                  "_key": "c2l1-034d3",
                  "label": "10%",
                  "value": 20
                },
                {
                  "_key": "c2l1-034d4",
                  "label": "20%",
                  "value": 10
                }
              ]
            },
            {
              "_key": "c2l1-035",
              "_type": "keyFact",
              "label": "Upfront margin rules",
              "value": "Brokers must collect margin before you trade",
              "context": "Under SEBI's peak margin framework, fully in force since September 2021, brokers must collect the required margin upfront. You cannot take a futures position today and bring the money tomorrow."
            },
            {
              "_key": "c2l1-036",
              "_type": "callout",
              "type": "warning",
              "text": "Having enough cash to meet the margin does not mean you can afford the position. Size your trade on how much you can lose if the price moves against you, not on how much margin your account balance allows."
            },
            {
              "_key": "c2l1-037",
              "_type": "block",
              "style": "h2",
              "markDefs": [],
              "children": [
                {
                  "_key": "c2l1-037s1",
                  "_type": "span",
                  "text": "Watching a Position Move: Five Days in Gold Mini",
                  "marks": []
                }
              ]
            },
            {
              "_key": "c2l1-038",
              "_type": "block",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_key": "c2l1-038s1",
                  "_type": "span",
                  "text": "Meera buys one lot of Gold Mini at the open on Day 1 at ₹1,00,000 per 10 grams. Contract value is ₹10,00,000, and at an illustrative 8% margin she deposits ₹80,000. Her tick value is ₹10. Here is how the next five sessions look.",
                  "marks": []
                }
              ]
            },
            {
              "_key": "c2l1-039",
              "_type": "candlestickChart",
              "title": "Gold Mini, five illustrative sessions (₹ per 10 grams)",
              "data": [
                {
                  "_key": "c2l1-039d1",
                  "date": "Day 1",
                  "open": 100000,
                  "high": 100650,
                  "low": 99700,
                  "close": 100400
                },
