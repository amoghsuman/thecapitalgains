                {
                  "_key": "c2l3-023d4",
                  "label": "Month 3",
                  "value": 6820
                },
                {
                  "_key": "c2l3-023d5",
                  "label": "Month 4",
                  "value": 6770
                }
              ]
            },
            {
              "_key": "c2l3-024",
              "_type": "comparison",
              "title": "Contango vs backwardation",
              "columns": [
                {
                  "_key": "c2l3-024c1",
                  "label": "Contango",
                  "points": [
                    "Futures above spot; later months higher",
                    "Basis is negative (spot minus futures)",
                    "Usually reflects ample supply and the cost of carry",
                    "Normal for gold and silver most of the time",
                    "Hurts long positions that are rolled repeatedly"
                  ]
                },
                {
                  "_key": "c2l3-024c2",
                  "label": "Backwardation",
                  "points": [
                    "Futures below spot; later months lower",
                    "Basis is positive",
                    "Usually reflects tight supply and high convenience yield",
                    "Common in crude oil during supply crunches, and in agri contracts before a new harvest arrives",
                    "Helps long positions that are rolled repeatedly"
                  ]
                }
              ]
            },
            {
              "_key": "c2l3-025",
              "_type": "table",
              "caption": "What the curve shape usually tells you (tendencies, not rules)",
              "headers": [
                "Commodity",
                "Typical structure",
                "Why"
              ],
              "rows": [
                {
                  "_key": "c2l3-025r1",
                  "_type": "tableRow",
                  "cells": [
                    "Gold",
                    "Contango",
                    "Huge above-ground stocks and cheap storage, so the curve mainly reflects interest rates"
                  ]
                },
                {
                  "_key": "c2l3-025r2",
                  "_type": "tableRow",
                  "cells": [
                    "Silver",
                    "Contango",
                    "Similar to gold, with slightly higher storage costs per rupee of value"
                  ]
                },
                {
                  "_key": "c2l3-025r3",
                  "_type": "tableRow",
                  "cells": [
                    "Crude oil",
                    "Flips between the two",
                    "Backwardation when supply is tight, as in 2022; steep contango when storage fills, as in 2020"
                  ]
                },
                {
                  "_key": "c2l3-025r4",
                  "_type": "tableRow",
                  "cells": [
                    "Agri (jeera, guar, cotton)",
                    "Seasonal",
                    "Contracts expiring before harvest can trade above those expiring after new supply arrives"
                  ]
                }
              ]
            },
            {
              "_key": "c2l3-026",
              "_type": "block",
              "style": "h2",
              "markDefs": [],
              "children": [
                {
                  "_key": "c2l3-026s1",
                  "_type": "span",
                  "text": "Convergence: Basis Goes to Zero at Expiry",
                  "marks": []
                }
              ]
            },
            {
              "_key": "c2l3-027",
              "_type": "block",
              "style": "normal",
              "markDefs": [
                {
                  "_key": "c2l3-027m1",
                  "_type": "glossaryTerm",
                  "definition": "Move towards the spot price as expiry approaches, until the basis is effectively zero on the expiry date."
                }
              ],
              "children": [
                {
                  "_key": "c2l3-027s1",
                  "_type": "span",
                  "text": "At expiry, a futures contract becomes a contract for immediate delivery, which is exactly what spot is. So the futures price must ",
                  "marks": []
                },
                {
                  "_key": "c2l3-027s2",
                  "_type": "span",
                  "text": "converge",
                  "marks": [
                    "c2l3-027m1"
                  ]
                },
                {
                  "_key": "c2l3-027s3",
                  "_type": "span",
                  "text": " to the spot price. Every day that passes, there is less carrying cost left to price in.",
                  "marks": []
                }
              ]
            },
            {
              "_key": "c2l3-028",
              "_type": "chart",
              "chartType": "line",
              "title": "Gold futures converging to spot (illustrative, 7% carry)",
              "xAxisLabel": "Days to expiry",
