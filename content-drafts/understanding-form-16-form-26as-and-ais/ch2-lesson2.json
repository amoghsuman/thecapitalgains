              ],
              "_key": "k79"
            },
            {
              "_key": "k80",
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_key": "k81",
                  "_type": "span",
                  "text": "Rows with nothing to report, such as other income in rows 7 and 8, are left out above. Now let us check the rows that most often go wrong.",
                  "marks": []
                }
              ],
              "markDefs": []
            },
            {
              "_key": "k82",
              "_type": "block",
              "style": "h3",
              "children": [
                {
                  "_key": "k83",
                  "_type": "span",
                  "text": "Row 1: Gross Salary",
                  "marks": []
                }
              ],
              "markDefs": []
            },
            {
              "_key": "k84",
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_key": "k85",
                  "_type": "span",
                  "text": "Row 1(a) is your cash salary, including basic, allowances and bonus. Row 1(b) is the taxable value of ",
                  "marks": []
                },
                {
                  "_key": "k87",
                  "_type": "span",
                  "text": "perquisites",
                  "marks": [
                    "k86"
                  ]
                },
                {
                  "_key": "k88",
                  "_type": "span",
                  "text": ", which come from Form 12BA. If you exercised ESOPs or have a company-leased car, this row should not be zero. Row 1(d) should match the gross salary on your March payslip's year-to-date column, and the amount paid in Part A.",
                  "marks": []
                }
              ],
              "markDefs": [
                {
                  "_key": "k86",
                  "_type": "glossaryTerm",
                  "definition": "Non-cash benefits from your employer that are taxable, such as a company car, rent-free accommodation or ESOP shares, valued under the rules and listed in Form 12BA."
                }
              ]
            },
            {
              "_key": "k89",
              "_type": "block",
              "style": "h3",
              "children": [
                {
                  "_key": "k90",
                  "_type": "span",
                  "text": "Row 2: HRA and Other Exemptions",
                  "marks": []
                }
              ],
              "markDefs": []
            },
            {
              "_key": "k91",
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_key": "k92",
                  "_type": "span",
                  "text": "HRA is exempt up to the lowest of three amounts. For FY 2025-26, only Delhi, Mumbai, Kolkata and Chennai count as metros for the 50% limit. Pune gets 40%.",
                  "marks": []
                }
              ],
              "markDefs": []
            },
            {
              "_type": "mathBlock",
              "latex": "\\text{HRA exempt} = \\min\\big(\\text{HRA received},\\; \\text{Rent paid} - 10\\%\\text{ of basic},\\; 40\\% \\text{ or } 50\\% \\text{ of basic}\\big)",
              "caption": "Basic salary includes dearness allowance if it counts for retirement benefits",
              "_key": "k93"
            },
            {
              "_type": "table",
              "caption": "Priya's HRA exemption",
              "headers": [
                "Limit",
                "Working",
                "Amount (₹)"
              ],
              "rows": [
                {
                  "_key": "k95",
                  "_type": "tableRow",
