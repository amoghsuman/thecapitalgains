                  "cells": [
                    "Rent paid minus 10% of basic",
                    "₹4,32,000 minus ₹90,000",
                    "3,42,000"
                  ]
                },
                {
                  "_key": "k99",
                  "_type": "tableRow",
                  "cells": [
                    "40% of basic (Pune, non-metro)",
                    "40% of ₹9,00,000",
                    "3,60,000"
