{
  "courseSlug": "understanding-form-16-form-26as-and-ais",
  "chapters": [
    {
      "title": "Chapter 4: AIS and TIS, the Full Picture of Your Financial Year",
      "lessons": [
        {
          "title": "AIS vs TIS: The Annual Information Statement and Taxpayer Information Summary",
          "slug": "ais-vs-tis-the-annual-information-statement-and-taxpayer-information-summary",
          "body": [
            {
              "_key": "k1",
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_key": "k2",
                  "_type": "span",
                  "text": "Form 26AS answered one question: what tax has already been paid for you. The Annual Information Statement answers a bigger one: what does the department know about your money this year? When Priya opens hers, she finds salary, two banks' worth of interest, a dividend and a mutual fund redemption. Beside it sits a second, shorter document, the Taxpayer Information Summary. One is the evidence. The other is what pre-fills her return. Knowing the difference saves you from both overpaying and underreporting.",
                  "marks": []
                }
              ],
              "markDefs": []
            },
            {
              "_key": "k3",
              "_type": "block",
              "style": "h2",
              "children": [
                {
                  "_key": "k4",
                  "_type": "span",
                  "text": "Opening AIS and TIS",
                  "marks": []
                }
              ],
              "markDefs": []
            },
            {
              "_key": "k5",
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_key": "k6",
                  "_type": "span",
                  "text": "Log in to the e-filing portal at incometax.gov.in with your PAN or Aadhaar.",
                  "marks": []
                }
              ],
              "markDefs": [],
              "listItem": "number",
              "level": 1
            },
            {
              "_key": "k7",
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_key": "k8",
                  "_type": "span",
                  "text": "Open ",
                  "marks": []
                },
                {
