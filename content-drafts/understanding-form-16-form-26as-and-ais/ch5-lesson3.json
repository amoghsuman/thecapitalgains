  "chapters": [
    {
      "title": "Chapter 5: Reconciling Everything Before You File",
      "lessons": [
        {
          "title": "Case Study: A Salaried Investor Reconciles Two Form 16s, 26AS and AIS",
          "slug": "case-study-a-salaried-investor-reconciles-two-form-16s-26as-and-ais",
          "body": [
            {
              "_key": "k1",
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_key": "k2",
                  "_type": "span",
                  "text": "Ishita Rao is a 31-year-old UX lead in Hyderabad. In FY 2025-26 she changed jobs, sold some shares on Zerodha, redeemed an equity mutual fund, earned FD and savings interest, received dividends and paid advance tax once. She is the kind of taxpayer this course was built for: nothing exotic, but enough moving parts that a click-through filing would go wrong in at least three places. Follow her from the day her documents arrive to the day her return is processed.",
                  "marks": []
                }
              ],
              "markDefs": []
            },
            {
              "_type": "statGrid",
              "stats": [
                {
                  "_key": "k4",
                  "label": "Employers",
                  "value": "2",
                  "context": "Switched on 1 September 2025"
                },
                {
                  "_key": "k6",
                  "label": "Gross salary",
                  "value": "₹16,50,000",
                  "context": "₹6,00,000 plus ₹10,50,000"
                },
                {
                  "_key": "k8",
                  "label": "Documents",
                  "value": "5",
                  "context": "Two Form 16s, Form 26AS, AIS, TIS"
                },
                {
                  "_key": "k10",
                  "label": "Problems found",
                  "value": "3",
                  "context": "One TDS gap, two wrong AIS entries"
                }
              ],
              "_key": "k11"
            },
            {
              "_key": "k12",
