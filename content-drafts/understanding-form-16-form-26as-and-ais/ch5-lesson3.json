              "_type": "block",
              "style": "h2",
              "children": [
                {
                  "_key": "k111",
                  "_type": "span",
                  "text": "Step 5: Which Regime?",
                  "marks": []
                }
              ],
              "markDefs": []
            },
            {
              "_key": "k112",
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_key": "k113",
                  "_type": "span",
                  "text": "With income and credits settled, Ishita calculates tax both ways. Her gains are taxed at special rates in either regime: short-term gains on listed shares at 20%, and long-term gains on equity funds at 12.5% on the amount above ₹1,25,000.",
                  "marks": []
                }
              ],
              "markDefs": []
            },
            {
              "_type": "table",
              "caption": "Tax under each regime, FY 2025-26",
              "headers": [
                "",
                "Old regime",
                "New regime"
              ],
              "rows": [
                {
                  "_key": "k115",
                  "_type": "tableRow",
                  "cells": [
