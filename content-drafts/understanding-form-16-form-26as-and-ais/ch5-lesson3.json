            {
              "_key": "k33",
              "_type": "block",
              "style": "h2",
              "children": [
                {
                  "_key": "k34",
                  "_type": "span",
                  "text": "Step 1: The Two Form 16s",
                  "marks": []
                }
              ],
              "markDefs": []
            },
            {
              "_key": "k35",
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_key": "k36",
                  "_type": "span",
                  "text": "Both certificates arrive by 15 June 2026. Ishita checks each Part A, then looks at how Employer B handled her previous salary.",
                  "marks": []
                }
              ],
              "markDefs": []
            },
            {
              "_type": "table",
              "caption": "Form 16 Part A summaries",
              "headers": [
                "",
                "Employer A",
                "Employer B"
