{
  "courseSlug": "understanding-form-16-form-26as-and-ais",
  "chapters": [
    {
      "title": "Chapter 3: Form 26AS, Your Tax Credit Statement",
      "lessons": [
        {
          "title": "Downloading Form 26AS From the e-Filing Portal",
          "slug": "downloading-form-26as-from-the-e-filing-portal",
          "body": [
            {
              "_key": "k1",
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_key": "k2",
                  "_type": "span",
                  "text": "Form 16 is what your employer says it deducted. Form 26AS is what the department actually has against your PAN. You cannot reconcile one without the other, and unlike Form 16, nobody emails Form 26AS to you. You have to go and get it. It takes about five minutes once you know the path, and the most common mistakes happen before you even click download.",
                  "marks": []
                }
              ],
              "markDefs": []
            },
            {
              "_type": "statGrid",
              "stats": [
                {
                  "_key": "k4",
                  "label": "Where",
                  "value": "e-Filing portal",
                  "context": "Redirects you to TRACES"
                },
                {
                  "_key": "k6",
                  "label": "When",
                  "value": "After mid-June",
                  "context": "Once Q4 statements are processed"
                },
                {
                  "_key": "k8",
                  "label": "Formats",
                  "value": "HTML, Text, PDF",
                  "context": "PDF via Export as PDF"
                }
              ],
              "_key": "k9"
            },
            {
              "_key": "k10",
              "_type": "block",
              "style": "h2",
              "children": [
                {
                  "_key": "k11",
                  "_type": "span",
                  "text": "Before You Start",
                  "marks": []
                }
              ],
              "markDefs": []
            },
            {
