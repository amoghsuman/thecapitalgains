                {
                  "_key": "k13",
                  "_type": "span",
                  "text": "An e-filing account.",
                  "marks": [
                    "strong"
                  ]
                },
                {
                  "_key": "k14",
                  "_type": "span",
                  "text": " You log in at incometax.gov.in using your PAN or Aadhaar as the user ID. First-time users register once with PAN and an OTP on the mobile number linked to Aadhaar.",
                  "marks": []
                }
              ],
              "markDefs": [],
              "listItem": "bullet",
              "level": 1
            },
            {
              "_key": "k15",
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_key": "k16",
                  "_type": "span",
                  "text": "The right year label.",
                  "marks": [
                    "strong"
                  ]
                },
                {
                  "_key": "k17",
                  "_type": "span",
                  "text": " Form 26AS on TRACES is still organised by assessment year. For income earned in FY 2025-26, you select ",
                  "marks": []
                },
                {
                  "_key": "k18",
                  "_type": "span",
                  "text": "AY 2026-27",
                  "marks": [
                    "strong"
                  ]
                },
                {
                  "_key": "k19",
                  "_type": "span",
                  "text": ".",
                  "marks": []
                }
              ],
              "markDefs": [],
              "listItem": "bullet",
              "level": 1
            },
            {
              "_key": "k20",
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_key": "k21",
                  "_type": "span",
                  "text": "Pop-ups allowed.",
                  "marks": [
                    "strong"
                  ]
                },
                {
                  "_key": "k22",
                  "_type": "span",
                  "text": " The portal hands you over to TRACES in a new window. If your browser blocks pop-ups, nothing appears to happen.",
                  "marks": []
                }
              ],
              "markDefs": [],
              "listItem": "bullet",
              "level": 1
            },
            {
              "_type": "callout",
              "type": "warning",
              "text": "The single most common error is picking the wrong year. If you select AY 2025-26 when you meant FY 2025-26, you are looking at the previous year's credits, and everything will seem not to match your Form 16. Always remember: assessment year = financial year + 1.",
              "_key": "k23"
            },
            {
