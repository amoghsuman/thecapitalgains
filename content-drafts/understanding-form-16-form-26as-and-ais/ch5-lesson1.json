            {
              "_type": "mathBlock",
              "latex": "\\text{Tax payable or refund} = \\text{Tax on total income} - (\\text{TDS} + \\text{TCS} + \\text{Advance tax} + \\text{Self-assessment tax})",
              "caption": "Why credits matter: every rupee reconciled here reduces what you pay or increases your refund",
              "_key": "k102"
