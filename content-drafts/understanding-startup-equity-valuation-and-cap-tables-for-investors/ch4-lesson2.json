                  "term": "Down round",
                  "definition": "A round priced lower per share than the previous round."
                },
                {
                  "_key": "k172",
                  "term": "Conversion price",
                  "definition": "The price at which a CCPS converts into equity. Lowering it gives the holder more equity shares."
                },
                {
                  "_key": "k174",
                  "term": "Full ratchet",
                  "definition": "Cuts the conversion price to the new round price, regardless of the round size."
                },
