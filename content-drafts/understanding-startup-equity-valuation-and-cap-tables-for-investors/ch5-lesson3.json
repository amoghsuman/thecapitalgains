            {
              "_key": "k159",
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_key": "k160",
                  "_type": "span",
                  "text": "A sale at ₹150 crore leaves ₹140 crore after debt and costs, below the ₹242.72 crore Series C post-money. Now the waterfall bites. The Series C fund would receive only 5,00,000 × ₹461.43 = ₹23.07 crore by converting, so it takes its ₹40 crore preference instead. The other ₹100 crore is shared by everyone else, all of whom are better off converting.",
                  "marks": []
                }
              ],
              "markDefs": []
            },
