            {
              "_key": "k149",
              "_type": "collapsible",
              "title": "For Python users: the same cap table in code",
              "content": [
                {
                  "_type": "codeBlock",
                  "language": "python",
                  "code": "cap = {\"Nisha\": 600_000, \"Farhan\": 400_000}\n\ndef raise_round(cap, investor, pre_money, investment):\n    fd_shares = sum(cap.values())\n    price = pre_money / fd_shares\n    cap[investor] = round(investment / price)\n    return price\n\ndef show(cap):\n    total = sum(cap.values())\n    for holder, shares in cap.items():\n        print(f\"{holder:<10}{shares:>10,}{shares / total:>9.2%}\")\n    print(f\"{'Total':<10}{total:>10,}\")\n\nraise_round(cap, \"Angels\", 5_00_00_000, 50_00_000)\ncap[\"ESOP pool\"] = 100_000\nraise_round(cap, \"Seed fund\", 18_00_00_000, 3_00_00_000)\nprice = raise_round(cap, \"Series A\", 56_00_00_000, 15_00_00_000)\nshow(cap)\nprint(f\"Series A price per share: ₹{price:,.0f}\")",
                  "caption": "Underscores let you group digits the Indian way, like 5_00_00_000. Python prints thousands separators in the international style, so 17,75,000 appears as 1,775,000.",
                  "_key": "k150"
                }
              ]
            },
