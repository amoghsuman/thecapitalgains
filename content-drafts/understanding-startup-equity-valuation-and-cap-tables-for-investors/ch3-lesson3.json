            {
              "_key": "k88",
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_key": "k89",
                  "_type": "span",
                  "text": "Look at the Series A investor. In structure B, it shares the pool's dilution and ends up at 18%. In structure C, which is what the term sheet asked for, it keeps a clean 20% and everyone else absorbs the entire pool. That is the ",
                  "marks": []
                },
                {
                  "_key": "k91",
                  "_type": "span",
                  "text": "option pool shuffle",
                  "marks": [
                    "k90"
                  ]
                },
                {
                  "_key": "k92",
                  "_type": "span",
                  "text": ".",
                  "marks": []
                }
              ],
              "markDefs": [
                {
                  "_key": "k90",
                  "_type": "glossaryTerm",
                  "definition": "Creating or enlarging an ESOP pool inside the pre-money valuation, so that only existing shareholders bear its dilution and the new investor does not."
                }
              ]
            },
            {
              "_key": "k93",
              "_type": "collapsible",
              "title": "Show me how structure C is calculated",
              "content": [
                {
                  "_key": "k94",
                  "_type": "block",
                  "style": "normal",
                  "children": [
                    {
                      "_key": "k95",
                      "_type": "span",
                      "text": "The investor wants 20% and the new pool must be 10% of post-money capital. That leaves 70% for the existing 10,00,000 shares.",
                      "marks": []
                    }
                  ],
                  "markDefs": []
                },
                {
                  "_key": "k96",
                  "_type": "block",
                  "style": "normal",
                  "children": [
                    {
                      "_key": "k97",
                      "_type": "span",
                      "text": "Total shares after:",
                      "marks": [
                        "strong"
                      ]
                    },
                    {
                      "_key": "k98",
                      "_type": "span",
                      "text": " 10,00,000 ÷ 70% = 14,28,571.",
                      "marks": []
                    }
                  ],
                  "markDefs": [],
                  "listItem": "number",
                  "level": 1
                },
                {
                  "_key": "k99",
                  "_type": "block",
                  "style": "normal",
                  "children": [
                    {
                      "_key": "k100",
                      "_type": "span",
                      "text": "New pool:",
                      "marks": [
                        "strong"
                      ]
                    },
                    {
                      "_key": "k101",
                      "_type": "span",
                      "text": " 10% × 14,28,571 = 1,42,857 shares.",
                      "marks": []
                    }
                  ],
                  "markDefs": [],
                  "listItem": "number",
                  "level": 1
                },
                {
                  "_key": "k102",
                  "_type": "block",
                  "style": "normal",
                  "children": [
                    {
                      "_key": "k103",
                      "_type": "span",
                      "text": "Series A shares:",
                      "marks": [
                        "strong"
                      ]
                    },
                    {
                      "_key": "k104",
                      "_type": "span",
                      "text": " 20% × 14,28,571 = 2,85,714 shares.",
                      "marks": []
                    }
                  ],
                  "markDefs": [],
                  "listItem": "number",
                  "level": 1
                },
                {
                  "_key": "k105",
                  "_type": "block",
                  "style": "normal",
                  "children": [
                    {
                      "_key": "k106",
                      "_type": "span",
                      "text": "Pre-money share count, including the new pool:",
                      "marks": [
                        "strong"
                      ]
                    },
                    {
                      "_key": "k107",
                      "_type": "span",
                      "text": " 10,00,000 + 1,42,857 = 11,42,857.",
                      "marks": []
                    }
                  ],
                  "markDefs": [],
                  "listItem": "number",
                  "level": 1
                },
                {
                  "_key": "k108",
                  "_type": "block",
                  "style": "normal",
                  "children": [
                    {
                      "_key": "k109",
                      "_type": "span",
                      "text": "Price per share:",
                      "marks": [
                        "strong"
                      ]
                    },
                    {
                      "_key": "k110",
                      "_type": "span",
                      "text": " ₹40 crore ÷ 11,42,857 = ₹350.",
                      "marks": []
                    }
                  ],
                  "markDefs": [],
                  "listItem": "number",
                  "level": 1
                },
                {
                  "_key": "k111",
                  "_type": "block",
                  "style": "normal",
                  "children": [
                    {
                      "_key": "k112",
                      "_type": "span",
                      "text": "Check:",
                      "marks": [
                        "strong"
                      ]
                    },
                    {
                      "_key": "k113",
                      "_type": "span",
                      "text": " ₹10 crore ÷ ₹350 = 2,85,714 shares, matching step 3.",
                      "marks": []
                    }
                  ],
                  "markDefs": [],
                  "listItem": "number",
                  "level": 1
                },
                {
                  "_key": "k114",
                  "_type": "block",
                  "style": "normal",
                  "children": [
                    {
                      "_key": "k115",
                      "_type": "span",
                      "text": "Share counts are rounded to whole shares.",
                      "marks": []
                    }
                  ],
                  "markDefs": []
                }
              ]
            },
            {
              "_key": "k116",
              "_type": "block",
              "style": "h2",
              "children": [
                {
                  "_key": "k117",
                  "_type": "span",
                  "text": "The Real Price: Effective Pre-Money Valuation",
                  "marks": []
                }
              ],
              "markDefs": []
            },
            {
              "_key": "k118",
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_key": "k119",
                  "_type": "span",
                  "text": "The term sheet says ₹40 crore pre-money. But ₹5 crore of that \"value\" is a pile of new, unissued options: 1,42,857 shares × ₹350 = ₹5 crore. The existing shareholders are really selling at a lower valuation.",
                  "marks": []
                }
              ],
              "markDefs": []
            },
            {
              "_type": "mathBlock",
              "latex": "\\text{Effective pre-money} = \\text{Headline pre-money} - \\text{New pool} \\times \\text{Price per share}",
              "caption": "The valuation existing shareholders actually receive",
              "_key": "k120"
            },
            {
              "_type": "statGrid",
              "stats": [
                {
                  "_key": "k122",
                  "label": "Headline pre-money",
                  "value": "₹40 crore",
                  "context": "As stated in the term sheet"
                },
                {
                  "_key": "k124",
                  "label": "Value of new pool",
                  "value": "₹5 crore",
                  "context": "1,42,857 × ₹350"
                },
                {
                  "_key": "k126",
                  "label": "Effective pre-money",
                  "value": "₹35 crore",
                  "context": "10,00,000 existing shares × ₹350"
                },
                {
                  "_key": "k128",
                  "label": "Price cut per share",
                  "value": "12.5%",
                  "context": "₹350 instead of ₹400"
                }
              ],
              "_key": "k129"
            },
            {
              "_type": "keyFact",
              "label": "What the shuffle costs you as a seed investor",
              "value": "12.00% → 10.50%",
              "context": "Compared with a round with no new pool, your group's stake falls by 1.5 percentage points, and every share you own is priced at ₹350 instead of ₹400 in this round.",
              "_key": "k130"
            },
            {
              "_type": "exercise",
              "variant": "numericInput",
              "title": "Find the effective pre-money",
              "prompt": "A term sheet offers ₹6 crore at a ₹24 crore pre-money valuation. It requires a new unallocated ESOP pool equal to 12% of post-money capital, created inside the pre-money valuation. What is the effective pre-money valuation for existing shareholders, in ₹ crore?",
              "correctValue": 20.4,
              "tolerance": 0.05,
              "unit": "₹ crore",
              "explanation": "Post-money = ₹24 crore + ₹6 crore = ₹30 crore. The new pool is 12% of post-money, worth 12% × ₹30 crore = ₹3.6 crore at the round price. Effective pre-money = ₹24 crore − ₹3.6 crore = ₹20.4 crore.",
              "_key": "k131"
            },
            {
              "_type": "exercise",
              "variant": "quiz",
              "title": "Who absorbs the dilution?",
              "question": "An ESOP pool top-up is created inside the pre-money valuation of a new round. Who bears its dilution?",
              "options": [
                "Only the new investor",
                "All shareholders, including the new investor, in proportion to their stakes",
                "Only existing shareholders before the round",
                "Nobody, because unallocated options are not shares"
              ],
              "correctIndex": 2,
              "explanation": "Because the pool is counted in the pre-money share count, the new investor's price already reflects it. The new investor keeps its full percentage, and founders, earlier investors and existing option holders absorb all of the pool's dilution.",
              "_key": "k132"
            },
            {
              "_key": "k133",
              "_type": "block",
              "style": "h2",
              "children": [
                {
                  "_key": "k134",
                  "_type": "span",
                  "text": "How Existing Shareholders Push Back",
                  "marks": []
                }
              ],
              "markDefs": []
            },
            {
              "_type": "comparison",
              "title": "Pool in pre-money vs pool in post-money",
              "columns": [
                {
                  "_key": "k136",
                  "label": "Pool in pre-money (investor-friendly)",
                  "points": [
                    "New investor gets its full target percentage",
                    "Founders and earlier investors bear all the dilution",
                    "Lower effective price per share",
                    "The market norm in most Indian Series A term sheets"
                  ]
                },
                {
                  "_key": "k138",
                  "label": "Pool in post-money (founder-friendly)",
                  "points": [
                    "New investor shares in the dilution",
                    "Effective pre-money equals the headline number",
                    "Existing holders keep more ownership",
                    "Harder to negotiate unless the round is competitive"
                  ]
                }
              ],
              "_key": "k139"
            },
            {
              "_key": "k140",
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_key": "k141",
                  "_type": "span",
                  "text": "Even when the pool has to sit in the pre-money, the size is negotiable. These are the levers founders and existing investors use.",
                  "marks": []
                }
              ],
              "markDefs": []
            },
            {
              "_key": "k142",
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_key": "k143",
                  "_type": "span",
                  "text": "Size the pool to a real hiring plan.",
                  "marks": [
                    "strong"
                  ]
                },
                {
                  "_key": "k144",
                  "_type": "span",
                  "text": " List the roles to be hired before the next round and the options each needs. If that adds up to 6%, a 10% demand is 4% of unnecessary dilution.",
                  "marks": []
                }
              ],
              "markDefs": [],
              "listItem": "number",
              "level": 1
            },
            {
              "_key": "k145",
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_key": "k146",
                  "_type": "span",
                  "text": "Count existing unallocated options.",
                  "marks": [
                    "strong"
                  ]
                },
                {
                  "_key": "k147",
                  "_type": "span",
                  "text": " If 3% is already unallocated, a 10% target only needs a 7% top-up.",
                  "marks": []
                }
              ],
              "markDefs": [],
              "listItem": "number",
              "level": 1
            },
            {
              "_key": "k148",
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_key": "k149",
                  "_type": "span",
                  "text": "Trade price for pool size.",
                  "marks": [
                    "strong"
                  ]
                },
                {
                  "_key": "k150",
                  "_type": "span",
                  "text": " A smaller pool at a slightly lower headline valuation can leave existing holders better off.",
                  "marks": []
                }
              ],
              "markDefs": [],
              "listItem": "number",
              "level": 1
            },
            {
              "_key": "k151",
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_key": "k152",
                  "_type": "span",
                  "text": "Plan to refresh later.",
                  "marks": [
                    "strong"
                  ]
                },
                {
                  "_key": "k153",
                  "_type": "span",
                  "text": " Top up the pool at the next round, when the valuation is higher and each option costs less ownership.",
                  "marks": []
