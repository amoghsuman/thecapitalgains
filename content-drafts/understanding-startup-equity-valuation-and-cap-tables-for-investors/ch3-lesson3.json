              ],
              "rows": [
                {
                  "_key": "k46",
                  "_type": "tableRow",
                  "cells": [
                    "Founders",
                    "8,00,000",
                    "80.00%"
                  ]
                },
                {
                  "_key": "k48",
                  "_type": "tableRow",
                  "cells": [
                    "Seed investors and angels (including you)",
                    "1,50,000",
                    "15.00%"
                  ]
                },
                {
                  "_key": "k50",
                  "_type": "tableRow",
                  "cells": [
                    "Existing ESOP pool, mostly granted",
                    "50,000",
                    "5.00%"
                  ]
                },
                {
                  "_key": "k52",
                  "_type": "tableRow",
                  "cells": [
                    "Total",
                    "10,00,000",
                    "100%"
                  ]
                }
              ],
              "_key": "k53"
            },
            {
              "_key": "k54",
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_key": "k55",
                  "_type": "span",
                  "text": "The term sheet offers ₹10 crore at a ₹40 crore pre-money valuation, so ₹50 crore post-money and 20% for the new investor. It also requires a new unallocated pool equal to 10% of post-money capital. Here are three ways the round could be structured.",
                  "marks": []
                }
              ],
              "markDefs": []
            },
            {
              "_type": "table",
              "caption": "Three ways to structure the same ₹10 crore round",
              "headers": [
                "Item",
                "A: No new pool",
                "B: Pool created in post-money",
                "C: Pool created in pre-money (term sheet)"
              ],
              "rows": [
