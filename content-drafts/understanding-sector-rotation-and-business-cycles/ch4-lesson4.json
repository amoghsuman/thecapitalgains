            {
              "_key": "c4l4k011",
              "_type": "block",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_key": "c4l4k011s1",
                  "_type": "span",
                  "text": "PSU bank relative strength stayed below its falling average from mid 2024 to April 2025, as the Act 2 leadership from Lesson 4.2 cooled. Through mid 2025 it moved sideways, roughly level with its average. Then, from September 2025, it broke clearly above an average that had turned upward, and kept climbing into 2026: a fresh leg of leadership that the ratio chart showed months before the full-year return tables did.",
                  "marks": []
                }
              ]
            },
            {
              "_key": "c4l4k012",
              "_type": "block",
              "style": "h2",
              "markDefs": [],
