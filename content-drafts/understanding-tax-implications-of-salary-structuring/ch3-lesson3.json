                {
                  "_key": "k48",
                  "_type": "span",
                  "text": ": include roughly what your family actually spends on domestic fares in a year when you travel. Unused LTA is not lost, it is simply taxed like special allowance.",
                  "marks": []
                }
              ],
              "markDefs": [],
              "listItem": "bullet",
              "level": 1
            },
